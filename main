from paciente import Paciente

pacientes:list[Paciente] = [
    Paciente("11.111.111-1", "Luis Arriagada", 40, "Isapre"),
    Paciente("22.222.222-2", "Paola Pardo", 40, "Fonasa")
]

def leer_numero (mensaje: str) -> int:
    while True:
        try:
            num=int(input(mensaje))
            return num
        except ValueError:
            print("Error: Deve ingresar un numero")



def menu()->int:
    print("Clinica")
    print("1.- Agregar Paciente")
    print("2.- Editar paciente")
    print("3.- Eliminar paciente")
    print("4.- Imprimir un paciente")
    print("5.- Imprimir todos los Pacientes")
    print("0.- Salir")
    opcion = leer_numero("Seleccione una opcion: ")
    return opcion

def agregar_pacinte()->None:
    rut = input("Ingrese el rut del paciente: ")
    nombre = input("Ingrese el nombre del paciente: ")
    edad = leer_numero("Ingrese edad del paciente: ")
    print("Previsiones disponibles: ")
    print("1.- Fonasa")
    print("2.- Isapre")
    print("3.- Particular")
    print("4.- Otros")
    prevision = leer_numero("seleccione una prevision: ")
    if prevision == 1:
        prevision = "Fonasa"
    elif prevision == 2:
        prevision = "Isapre"
    elif prevision == 3:
        prevision = "Particular"
    elif prevision == 4:
        prevision = "Otro"
    else:
        prevision = ""
        print("opcion no Valida")
        return
    pacientes.append(Paciente(rut, nombre, edad, prevision))

    def imprimir_pacientes()->None:
        if paciente:
            for paciente in pacientes:
                print(paciente)
        else:
            print("no hay pacientes registrados")


def main()->None:
    while True:
        op=menu()
        if op==1:
            print("Agregando paciente")
            agregar_pacinte()
        elif op==2:
            print("editando Paciente")
        elif op==3:
            print("Eliminando paciente")
        elif op==4:
            print("imprimiendo un paciente")
        elif op==5:
            print("imprimiendo todos los pacientes")
        elif op>5:
            print("opcion no encontrada")
        elif op==0:
            print("saliendo del programa")
            break




if __name__ == "__main__":
    main()